# ─── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=

# ─── Model Config ─────────────────────────────────────────────────────────────
LLM_PARSER_MODEL=llama-3.1-8b-instant

# ─── Vector Database ──────────────────────────────────────────────────────────
VECTOR_DB_PATH=./data/vectordb
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ─── Retrieval Settings ───────────────────────────────────────────────────────
RETRIEVAL_MODE=vector
TOP_K=20

# ─── MySQL Database ───────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=spinneys_database
